# Supabase – from Dashboard → Connect / Settings → API
# Project URL (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Client key (required): use Publishable key (sb_publishable_...) or legacy anon (JWT).
# Safe to expose in browser. Docs recommend publishable for new apps.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server key (required for admin + some server actions): use Secret key (sb_secret_...) or legacy service_role (JWT).
# NEVER expose in browser. Get from Dashboard → Settings → API → Secret keys (create one) or Legacy → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Gemini API (server-side; optional if users provide own key)
GOOGLE_GEMINI_API_KEY=your-gemini-api-key

# Optional: override models (defaults below)
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.0-flash-exp-image-generation
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Admin dashboard: set and send X-Admin-Secret header to view /admin
ADMIN_SECRET=
