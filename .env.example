# ──────────────────────────────────────────────────────────────────────
# Supabase – from Dashboard → Connect / Settings → API
# ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# ──────────────────────────────────────────────────────────────────────
# Gemini API (server-side; optional if users provide own key)
# ──────────────────────────────────────────────────────────────────────
GOOGLE_GEMINI_API_KEY=your-gemini-api-key
# Optional model overrides (defaults shown)
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_SUMMARY_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.0-flash-exp-image-generation
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore

# ──────────────────────────────────────────────────────────────────────
# Orchestrator service (Python FastAPI)
# ──────────────────────────────────────────────────────────────────────
# Dev default (dev workstation, no conflicting service): port 8000. Production
# on the agent host the core binds 127.0.0.1:8010 because another service owns 8000.
ORCHESTRATOR_URL=http://localhost:8000

# Core URL the PWA client calls. Leave empty for production: the client uses
# relative /v1/* requests and Caddy proxies them same-origin. For `npm run dev`,
# set NEXT_PUBLIC_CORE_URL=http://localhost:8000 in `.env.local` instead.
NEXT_PUBLIC_CORE_URL=

# Model the agent loop uses for chat (required; no default). e.g. gpt-5-codex.
# It is resolved against each provider's catalog; the first provider that lists
# it wins, and a provider failure before the first token falls over to the next.
POTAETO_MODEL=

# Preferred provider for POTAETO_MODEL: `opencode_go` or `openrouter`. Empty
# uses registration order, promoting whichever provider lists the model.
POTAETO_PROVIDER=

# Cap on provider output tokens per call (default 4096). Sent as `max_tokens`;
# when omitted, OpenRouter treats the model maximum (e.g. 131072) as the
# requirement and can reject the request with a 402 insufficient-credit error.
POTAETO_MAX_OUTPUT_TOKENS=4096

# Memory scope used for retrieval (default `project:Anveshak`). A project scope
# widens results to that project plus `global`; `global` means global only.
POTAETO_MEMORY_SCOPE=project:Anveshak

# Context window budget. The per-turn budget is derived from the selected
# model's catalog context length, minus POTAETO_MAX_OUTPUT_TOKENS and a small
# safety margin, then clamped into [floor, ceiling].
POTAETO_CONTEXT_CEILING=32000
POTAETO_CONTEXT_FLOOR=4000

# `Secure` on the device cookie. Defaults to 1 (production). Set 0 only for
# local development over plain http://localhost.
POTAETO_COOKIE_SECURE=1

# Canonical markdown memory tree, indexed once at startup (and on demand with
# `python -m app.cli index-memory`). Empty disables startup indexing.
# POTAETO_MEMORY_DIR=/home/operator/agent-memory

# Optional Telegram remote chat. The bot starts only when both are set and
# ignores every chat not listed (fail-closed).
# TELEGRAM_BOT_TOKEN=123456:your-bot-token
# TELEGRAM_ALLOWED_CHAT_IDS=123456789

# Background runner for /v1/jobs. Enabled here so a fresh deployment actually
# executes created jobs; set to 0 to store definitions without running them.
# `notify` steps are delivered to TELEGRAM_ALLOWED_CHAT_IDS, so set the two
# Telegram vars above as well. Values: 1/true/yes/on.
POTAETO_SCHEDULER_ENABLED=1

# SQLite database for the core (default: data/potaeto.db). Production uses the
# writable data directory granted to the systemd unit.
# POTAETO_DB_PATH=/opt/potaeto/data/potaeto.db

# Per-caller request budgets over a 60-second window. Pairing is keyed by client
# IP (via the trusted loopback proxy), chat by paired device.
# RATE_LIMIT_PAIR_PER_MIN=10
# RATE_LIMIT_CHAT_PER_MIN=30

# Streaming chat providers. Each is registered only when its key is set. The
# agent loop resolves POTAETO_MODEL against both catalogs, so configure at
# least one extra provider as a fallback.
# OPENCODE_API_KEY=oc_sk_your-opencode-go-key
# OPENCODE_BASE_URL=https://opencode.ai/inference/go
# OPENROUTER_API_KEY=sk-or-v1-your-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://your-site.example
# OPENROUTER_APP_TITLE=Potaeto

# For the orchestrator itself (when running standalone):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# ──────────────────────────────────────────────────────────────────────
# Optional providers for orchestrator
# ──────────────────────────────────────────────────────────────────────
# GROQ_API_KEY=your-groq-api-key
# HF_INFERENCE_BASE_URL=https://your-hf-endpoint/v1
# HF_API_KEY=your-hf-api-key

# Which providers to initialize (comma-separated; default: gemini,groq,huggingface)
# ENABLED_PROVIDERS=gemini,groq,huggingface

# ──────────────────────────────────────────────────────────────────────
# Admin
# ──────────────────────────────────────────────────────────────────────
ADMIN_SECRET=

# ──────────────────────────────────────────────────────────────────────
# Smart routing / health (all optional, sensible defaults)
# ──────────────────────────────────────────────────────────────────────
# MODELS_CONFIG_CACHE_TTL_SEC=60
# MODEL_DEFAULT_PRIORITY=100
# HEALTH_ROLLING_WINDOW_SIZE=30
# HEALTH_RATE_LIMIT_BASE_BACKOFF=15
# HEALTH_RATE_LIMIT_MAX_BACKOFF=300
# HEALTH_ERROR_BASE_BACKOFF=3
# HEALTH_ERROR_MAX_BACKOFF=30
# HEALTH_HEALTHY_THRESHOLD=0.90
# HEALTH_DEGRADED_THRESHOLD=0.50
# HEALTH_DEGRADED_PENALTY=50
# HEALTH_UNHEALTHY_PENALTY=200

# ──────────────────────────────────────────────────────────────────────
# App tuning (all optional, sensible defaults)
# ──────────────────────────────────────────────────────────────────────
# CHAT_RECENT_MESSAGES_LIMIT=10
# CHAT_MEMORIES_LIMIT=5
# CONVERSATION_HISTORY_LIMIT=50
# SUMMARY_TRIGGER_EVERY=10
# SUMMARY_MAX_CHARS=1200
# SUMMARY_SOURCE_MESSAGES=20
# PROACTIVE_IDLE_HOURS=24
# PROACTIVE_MAX_PER_RUN=10
# PROACTIVE_FACTS_LIMIT=5
# SKILL_OUTPUTS_DEFAULT_LIMIT=15
# SKILL_OUTPUTS_MAX_LIMIT=50
# LIBRARY_CONTENT_LIMIT=50
# SHARE_CONTENT_LIMIT=30
# ADMIN_LOGS_LIMIT=1000
# ADMIN_USAGE_LOGS_LIMIT=5000
# ADMIN_MEMORY_LIMIT=30
# ADMIN_ROUTING_LOGS_LIMIT=50
