# ──────────────────────────────────────────────────────────────────────
# Supabase – from Dashboard → Connect / Settings → API
# ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# ──────────────────────────────────────────────────────────────────────
# Gemini API (server-side; optional if users provide own key)
# ──────────────────────────────────────────────────────────────────────
GOOGLE_GEMINI_API_KEY=your-gemini-api-key
# Optional model overrides (defaults shown)
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_SUMMARY_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.0-flash-exp-image-generation
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore

# ──────────────────────────────────────────────────────────────────────
# Orchestrator service (Python FastAPI)
# ──────────────────────────────────────────────────────────────────────
ORCHESTRATOR_URL=http://localhost:8000

# For the orchestrator itself (when running standalone):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# ──────────────────────────────────────────────────────────────────────
# Optional providers for orchestrator
# ──────────────────────────────────────────────────────────────────────
# GROQ_API_KEY=your-groq-api-key
# HF_INFERENCE_BASE_URL=https://your-hf-endpoint/v1
# HF_API_KEY=your-hf-api-key

# Which providers to initialize (comma-separated; default: gemini,groq,huggingface)
# ENABLED_PROVIDERS=gemini,groq,huggingface

# ──────────────────────────────────────────────────────────────────────
# Admin
# ──────────────────────────────────────────────────────────────────────
ADMIN_SECRET=

# ──────────────────────────────────────────────────────────────────────
# Smart routing / health (all optional, sensible defaults)
# ──────────────────────────────────────────────────────────────────────
# MODELS_CONFIG_CACHE_TTL_SEC=60
# MODEL_DEFAULT_PRIORITY=100
# HEALTH_ROLLING_WINDOW_SIZE=30
# HEALTH_RATE_LIMIT_BASE_BACKOFF=15
# HEALTH_RATE_LIMIT_MAX_BACKOFF=300
# HEALTH_ERROR_BASE_BACKOFF=3
# HEALTH_ERROR_MAX_BACKOFF=30
# HEALTH_HEALTHY_THRESHOLD=0.90
# HEALTH_DEGRADED_THRESHOLD=0.50
# HEALTH_DEGRADED_PENALTY=50
# HEALTH_UNHEALTHY_PENALTY=200

# ──────────────────────────────────────────────────────────────────────
# App tuning (all optional, sensible defaults)
# ──────────────────────────────────────────────────────────────────────
# CHAT_RECENT_MESSAGES_LIMIT=10
# CHAT_MEMORIES_LIMIT=5
# CONVERSATION_HISTORY_LIMIT=50
# SUMMARY_TRIGGER_EVERY=10
# SUMMARY_MAX_CHARS=1200
# SUMMARY_SOURCE_MESSAGES=20
# PROACTIVE_IDLE_HOURS=24
# PROACTIVE_MAX_PER_RUN=10
# PROACTIVE_FACTS_LIMIT=5
# SKILL_OUTPUTS_DEFAULT_LIMIT=15
# SKILL_OUTPUTS_MAX_LIMIT=50
# LIBRARY_CONTENT_LIMIT=50
# SHARE_CONTENT_LIMIT=30
# ADMIN_LOGS_LIMIT=1000
# ADMIN_USAGE_LOGS_LIMIT=5000
# ADMIN_MEMORY_LIMIT=30
# ADMIN_ROUTING_LOGS_LIMIT=50
